{
  "platform": {
    "apiRuntime": "python:3.12"
  },
  "routes": [
    {
      "route": "/api/*",
      "allowedRoles": ["anonymous"],
      "methods": ["GET", "POST", "OPTIONS", "PUT", "DELETE"],
      "headers": {
        "Access-Control-Allow-Origin": "*",
        "Access-Control-Allow-Methods": "GET, POST, OPTIONS, PUT, DELETE",
        "Access-Control-Allow-Headers": "Content-Type, Authorization, x-admin-key, x-ms-blob-type, x-user-id, x-cashflow-user-id, x-app-role",
        "Access-Control-Expose-Headers": "x-ms-request-id"
      }
    }
  ],
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": ["/api/*", "/assets/*", "/.auth/*", "/robots.txt", "/sitemap.xml", "/*.png", "/*.svg"]
  }
}
